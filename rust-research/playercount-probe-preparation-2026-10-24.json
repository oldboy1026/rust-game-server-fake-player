      "observations": [
        {
          "area": "authorization",
          "result": "Snapshot allows RCON, local server console or authLevel>=2; Focus is RCON-only and validates 17 decimal digits, <=20, no duplicates. Error replies do not echo input."
        },
        {
          "area": "state_mutations",
          "result": "No writes to game population, BasePlayer/input, authentication, configuration, report metadata or outgoing network. rawTickCount is getter-only. Writes are limited to plugin counters, epoch, timer/events and sample cache."
        },
        {
          "area": "threads",
          "result": "Steam event handlers access only immutable window, primitive identity classification and atomic counters/string references. Sampling game objects is confined to normal Oxide timer or admin command; this assumes the framework schedules them on main thread. Focus swaps an immutable epoch, so in-flight callbacks complete against old counters."
        },
        {
          "area": "output",
          "result": "Explicit aggregate shape excludes focus IDs, usernames, coordinates/input contents, callback owner/user identities, reasons and tokens. Module MVIDs and boolean EAC/Steam state remain distinct; no EAC success or trusted-count receipt claim follows."
        },
        {
          "area": "freshness",
          "result": "rawTickRatePositive counts active players whose cached raw rate estimate is positive. No cumulative difference or ambiguous last-tick age is used; optional inputHookObserved=false explicitly means no observed callback since window start."
        },
        {
          "area": "input_callback_small_change",
          "result": "OnPlayerInput atomically stores UTC DateTime ticks rather than formatting a string. WithCallbacks reads input count once for both inputHookCalls and inputHookObserved and formats one timestamp during sampling. The reviewed change retains the void hook, epoch classification, read-only game access and aggregate-only output."
        }
      ],
      "nonblockingNotes": [
        {
          "id": "callback_snapshot_coherence",
          "detail": "Validation/ok/nonOk and input count/timestamp are independent atomic reads/writes. A concurrent callback can yield a transient non-transactional tuple; do not treat one snapshot as exact accounting equality or last timestamp proof."
        },
        {
          "id": "scope_of_counts",
          "detail": "Grouped counters reset with focus epoch; Steam connected/disconnected counters are plugin lifetime counters. State active/network/EAC metrics are separate aggregates, not a cross-joined claim about one player unless group cardinality and actual identity match are independently established."
        },
        {
          "id": "framework_audit_logging",
