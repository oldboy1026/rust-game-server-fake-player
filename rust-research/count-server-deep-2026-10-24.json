    {
      "id": "manual_dispatch_and_cleanup",
      "finding": "Dispatch.Frame prevents reentry, invokes native ManualDispatch_RunFrame, drains GetNextCallback, processes each server/client classified callback and frees the last callback in finally. Exceptions are delivered to OnException when installed; runningFrame is cleared in finally.",
      "boundary": "These managed operations process callbacks; they are not evidence of successful external registration, a backend player-count acknowledgement or the native heartbeat interval.",
      "evidence": [
        {
          "module": "Facepunch.Steamworks.Win64.dll",
          "method": "System.Void Steamworks.Dispatch::Frame(Steamworks.Data.HSteamPipe)",
          "metadataToken": "0x06000016",
          "ilRanges": [
            [
              "IL_0000",
              "IL_0067"
            ]
          ]
        }
      ]
    },
