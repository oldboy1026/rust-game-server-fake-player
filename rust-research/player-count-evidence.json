  "findings": [
    {
      "id": "active-list-before-hook",
      "finding": "PlayerInit adds the player to activePlayerList before the standard Oxide hook injection point.",
      "limitation": "Does not independently prove completed client world loading or a particular EAC policy outcome."
    },
    {
      "id": "cp-from-active-list",
      "finding": "UpdateServerInformation formats cp from activePlayerList.Count, then publishes GameTags.",
      "limitation": "Does not establish A2S_INFO players semantics or the field selected by the Rust client browser."
    },
    {
      "id": "server-info-schedule",
      "finding": "StartSteamServer invokes UpdateServerInformation after 2 seconds, repeating every 30 seconds.",
      "limitation": "This is the server scheduling interval, not a guaranteed browser refresh deadline."
    },
    {
      "id": "steam-player-data-path",
      "finding": "Auth_Steam success calls UpdatePlayerSession, then SteamServer.UpdatePlayer and BUpdateUserData; the final wrapper discards the native boolean result.",
      "limitation": "No observed failure or proven effect on the target player count; native SDK behavior was not inspected."
    },
    {
      "id": "censored-names",
      "finding": "The inspected censorplayerlist branch changes the selected name before UpdatePlayerSession; it does not skip that call.",
      "limitation": "Does not describe every other use of this setting in the game."
    }
  ]
